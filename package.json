{
  "name": "cse110-project-team3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "tsc --project tsconfig.contracts.json",
    "test:browser:types": "tsc --project tsconfig.browser.json",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e": "playwright test",
    "test:ci-policy": "node --test scripts/ci/*.test.mjs",
    "test:coverage:changed": "node scripts/ci/changed-coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "konva": "^10.9.1"
  }
}
